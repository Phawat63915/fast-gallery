# FastGallery Configuration Settings

# Port for Backend Server (default: 8880)
PORT=8880

# Frontend Directory path to serve (default: frontends/1-vanilla-worker)
# Options: frontends/1-vanilla-worker, frontends/2-svelte, frontends/3-vue, frontends/4-react, frontends/5-vanilla-root
FRONTEND_DIR=frontends/1-vanilla-worker

# Disable thumbnails and serve original high-res photos directly (true / false)
DISABLE_THUMBNAILS=false

# Database Connection URL (sqlite or postgres connection string)
# Examples:
# DB_URL=sqlite
# DB_URL=postgres://postgres:postgres@localhost:5432/fastgallery?sslmode=disable
DB_URL=sqlite

# Data directory path (default: data)
DATA_DIR=data
